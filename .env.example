# Copy to .env for a new installation and replace both secret placeholders.
# On this machine, keep the existing .env: it selects the restored database
# oracle_db_restored_20261013 and contains the working credentials.
POSTGRES_DB=oracle_db
POSTGRES_USER=oracle_admin
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
